<launch>
  <arg name="config" default="$(find hardware_bringup)/config/hardware.yaml"/>
  <arg name="arms" default="all"/>
  <arg name="cameras" default="all"/>
  <arg name="fps" default="0"/>
  <arg name="dry_run" default="false"/>
  <arg name="mode" default="record"/>
  <arg name="require_leader_targets" default="false"/>
  <arg name="teleop" default="false"/>
  <node pkg="hardware_bringup" type="hardware_manager.py" name="agilex_hardware" output="screen" required="true">
    <param name="config" value="$(arg config)"/>
    <param name="arms" value="$(arg arms)"/>
    <param name="cameras" value="$(arg cameras)"/>
    <param name="fps" value="$(arg fps)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
    <param name="mode" value="$(arg mode)"/>
    <param name="require_leader_targets" value="$(arg require_leader_targets)"/>
    <param name="teleop" value="$(arg teleop)"/>
  </node>
</launch>
