<?xml version="1.0"?>
<package format="2">
  <name>hardware_bringup</name>
  <version>0.1.0</version>
  <description>Receive-only Piper leader-follower acquisition and serial-bound D435 hardware supervision</description>
  <maintainer email="robot@localhost.localdomain">Robot Lab</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>rospy</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>roscpp</depend>
  <depend>librealsense2</depend>
  <depend>std_msgs</depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>roslaunch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-can</exec_depend>
</package>
