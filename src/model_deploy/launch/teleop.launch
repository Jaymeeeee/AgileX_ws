<launch>
  <arg name="config" default="$(find model_deploy)/config/teleop.yaml"/>
  <arg name="hardware_config" default="$(find hardware_bringup)/config/hardware.yaml"/>
  <arg name="arms" default="both"/>
  <arg name="execute" default="false"/>
  <arg name="cameras" default="none"/>
  <include file="$(find hardware_bringup)/launch/hardware.launch">
    <arg name="config" value="$(arg hardware_config)"/>
    <arg name="mode" value="record"/>
    <arg name="teleop" value="true"/>
    <arg name="arms" value="$(eval 'all' if arg('arms') == 'both' else arg('arms'))"/>
    <arg name="cameras" value="$(arg cameras)"/>
  </include>
  <group if="$(eval arg('arms') in ['both', 'left'])">
  <node pkg="model_deploy" type="piper_teleop_node.py" name="teleop_left_leader" required="true" output="screen">
    <param name="arms" value="$(arg arms)"/>
    <param name="config" value="$(arg config)"/><param name="side" value="left"/><param name="role" value="leader"/><param name="execute" value="$(arg execute)"/>
  </node>
  </group>
  <group if="$(eval arg('arms') in ['both', 'right'])">
  <node pkg="model_deploy" type="piper_teleop_node.py" name="teleop_right_leader" required="true" output="screen">
    <param name="arms" value="$(arg arms)"/>
    <param name="config" value="$(arg config)"/><param name="side" value="right"/><param name="role" value="leader"/><param name="execute" value="$(arg execute)"/>
  </node>
  </group>
  <group if="$(eval arg('arms') in ['both', 'left'])">
  <node pkg="model_deploy" type="piper_teleop_node.py" name="teleop_left_follower" required="true" output="screen">
    <param name="arms" value="$(arg arms)"/>
    <param name="config" value="$(arg config)"/><param name="side" value="left"/><param name="role" value="follower"/><param name="execute" value="$(arg execute)"/>
  </node>
  </group>
  <group if="$(eval arg('arms') in ['both', 'right'])">
  <node pkg="model_deploy" type="piper_teleop_node.py" name="teleop_right_follower" required="true" output="screen">
    <param name="arms" value="$(arg arms)"/>
    <param name="config" value="$(arg config)"/><param name="side" value="right"/><param name="role" value="follower"/><param name="execute" value="$(arg execute)"/>
  </node>
  </group>
</launch>
