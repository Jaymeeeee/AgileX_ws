<?xml version="1.0"?>
<package format="2">
  <name>model_deploy</name>
  <version>0.2.0</version>
  <description>ROS1 dual Piper ACT deployment with isolated LeRobot inference and SDK control</description>
  <maintainer email="robot@localhost.localdomain">Robot Lab</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>hardware_bringup</depend>
  <exec_depend>rosbag</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-can</exec_depend>
</package>
